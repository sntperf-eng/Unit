---
import Icon from './Icon.astro';
import { kitItems } from '../data/site';
---

<section class="kit section" id="kit">
  <div class="container">
    <div class="kit__head">
      <div class="kit__intro">
        <p class="eyebrow" data-reveal>Le kit NAYRA</p>
        <h2 class="section-title" data-reveal style="--reveal-delay: 60ms">
          Tout le nécessaire pour une manucure naturelle.
        </h2>
        <p class="lead" data-reveal style="--reveal-delay: 120ms">
          Douze éléments réunis avec soin pour transformer un simple geste en
          véritable rituel de beauté. Rien de superflu, tout l'essentiel.
        </p>
        <a href="#rituel" class="btn btn--ghost kit__cta" data-reveal style="--reveal-delay: 180ms">
          Voir le rituel
          <Icon name="arrow" size={16} class="btn__arrow" />
        </a>
      </div>

      <div class="kit__count" data-reveal aria-hidden="true">
        <span class="kit__count-num" data-count="12">12</span>
        <span class="kit__count-label">éléments</span>
      </div>
    </div>

    <figure class="kit__showcase img-reveal" data-reveal>
      <img
        src="/kit-flat.webp"
        width="1000"
        height="601"
        alt="L'ensemble du kit NAYRA : henné, huile cuticules, bol en silicone, pochette, guide, lime, buffer, repousse-cuticules, brossette, séparateur d'orteils et stickers."
        loading="lazy"
        decoding="async"
      />
    </figure>

    <ul class="kit__grid">
      {kitItems.map((item, i) => (
        <li class="kit-card" data-reveal style={`--reveal-delay: ${(i % 3) * 70}ms`}>
          <span class="kit-card__num">{String(i + 1).padStart(2, '0')}</span>
          <span class="kit-card__icon">
            <Icon name={item.icon} size={24} />
          </span>
          <div class="kit-card__body">
            <h3 class="kit-card__name">{item.name}</h3>
            <p class="kit-card__label">{item.label}</p>
            <p class="kit-card__desc">{item.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Compteur animé « 12 éléments » — se déclenche à l'apparition.
  const el = document.querySelector<HTMLElement>('[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce && 'IntersectionObserver' in window) {
    const target = parseInt(el.dataset.count || '0', 10);
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        const duration = 1100;
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(eased * target));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        el.textContent = '0';
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    io.observe(el);
  }
</script>

<style>
  .kit {
    background: linear-gradient(180deg, var(--cream) 0%, var(--ivory) 100%);
  }
  .kit__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }
  .kit__intro {
    max-width: 46ch;
  }
  .kit__intro .lead {
    margin-top: var(--space-sm);
  }
  .kit__cta {
    margin-top: var(--space-md);
  }
  .kit__count {
    flex: none;
    text-align: center;
    line-height: 1;
  }
  .kit__count-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4rem, 9vw, 7rem);
    color: var(--rose-gold);
  }
  .kit__count-label {
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mist);
  }

  /* Grande photo du kit */
  .kit__showcase {
    margin: 0 0 var(--space-xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .kit__showcase img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 1.2s var(--ease);
  }
  .kit__showcase:hover img {
    transform: scale(1.02);
  }

  /* Grille des 12 éléments */
  .kit__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1.15rem);
  }
  .kit-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding: var(--space-md);
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  .kit-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
    border-color: var(--sand);
  }
  .kit-card__num {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--sand);
  }
  .kit-card__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: var(--rose-gold);
    background: radial-gradient(circle at 50% 40%, #fff 0%, var(--cream) 100%);
    border: 1px solid var(--line);
  }
  .kit-card__body {
    min-width: 0;
  }
  .kit-card__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.15;
  }
  .kit-card__label {
    margin-top: 0.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rose-gold);
  }
  .kit-card__desc {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--stone);
  }

  @media (max-width: 860px) {
    .kit__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .kit__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 540px) {
    .kit__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
