---
import { nav } from '../data/site';
---

<header class="header" data-header>
  <div class="header__inner container">
    <a href="#top" class="header__logo" aria-label="NAYRA — retour en haut">
      <span class="brand-mark"></span>
    </a>

    <nav class="header__nav" aria-label="Navigation principale">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} class="header__link link-underline">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="#kit" class="header__cta">Commander</a>

    <button
      class="header__burger"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-burger
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Navigation mobile">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} data-mobile-link>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="#kit" class="btn btn--ghost" data-mobile-link>Commander le kit</a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    /* teinte identique au fond du logotype → le mot NAYRA se fond dans la barre */
    background-color: var(--beige-logo);
    transition: box-shadow 0.5s var(--ease);
  }
  .header.is-scrolled {
    box-shadow: 0 8px 30px rgba(44, 39, 35, 0.06),
      0 1px 0 rgba(169, 129, 77, 0.22);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    height: 88px;
    transition: height 0.5s var(--ease);
  }
  .header.is-scrolled .header__inner {
    height: 70px;
  }
  .header__logo {
    flex: none;
    display: flex;
    align-items: center;
  }
  .header__logo .brand-mark {
    --bh: 30px;
    transition: opacity 0.4s var(--ease);
  }
  .header__logo:hover .brand-mark {
    opacity: 0.72;
  }
  .header__nav {
    margin-inline: auto;
  }
  .header__nav ul {
    display: flex;
    gap: clamp(1.2rem, 2.4vw, 2.6rem);
  }
  .header__link {
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .header__cta {
    flex: none;
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.7em 1.6em;
    color: var(--ink);
    border: 1px solid var(--gold);
    border-radius: var(--radius);
    transition: color 0.4s var(--ease), background-color 0.4s var(--ease);
  }
  .header__cta:hover {
    background-color: var(--gold);
    color: #fff;
  }
  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 40px;
    height: 40px;
    padding: 8px;
  }
  .header__burger span {
    display: block;
    height: 1.25px;
    width: 100%;
    background: var(--ink);
    transition: transform 0.4s var(--ease), opacity 0.3s var(--ease);
  }
  .header__burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.6px) rotate(45deg);
  }
  .header__burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.6px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 0;
    background: var(--beige-logo);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease), visibility 0.5s var(--ease);
    z-index: 99;
  }
  .mobile-menu[data-open] {
    opacity: 1;
    visibility: visible;
  }
  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    text-align: center;
  }
  .mobile-menu a[data-mobile-link]:not(.btn) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .header__nav,
    .header__cta {
      display: none;
    }
    .header__burger {
      display: flex;
    }
  }
</style>
