---
import { brand } from '../data/site';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="hero__bg" data-parallax data-parallax-speed="0.08" aria-hidden="true"></div>
  <canvas class="hero__particles" data-particles aria-hidden="true"></canvas>

  <div class="hero__inner container">
    <p class="hero__eyebrow" data-reveal>Coloration des ongles au henné</p>

    <h1 class="visually-hidden">{brand.name} — {brand.slogan}</h1>

    <img
      class="hero__logo"
      src="/nayra-logo.webp"
      width="1120"
      height="1120"
      alt={`${brand.name} — ${brand.slogan}`}
      fetchpriority="high"
      decoding="async"
      data-reveal
    />

    <p class="hero__baseline" data-reveal style="--reveal-delay: 160ms">
      {brand.baseline}
    </p>

    <div class="hero__actions" data-reveal style="--reveal-delay: 280ms">
      <a href="#kit" class="btn">
        Découvrir le kit
        <Icon name="arrow" size={17} class="btn__arrow" />
      </a>
      <a href="#marque" class="hero__secondary link-underline">Notre histoire</a>
    </div>
  </div>

  <a href="#marque" class="hero__scroll" aria-label="Défiler vers le bas">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-text">Découvrir</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(6rem, 11vh, 9rem) var(--space-xl);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: 0 -10%;
    z-index: -1;
    background:
      linear-gradient(180deg, var(--beige-logo) 0%, transparent 20%),
      radial-gradient(58% 56% at 50% 44%, #e8d8cb 0%, #efe6d7 48%, var(--ivory) 100%);
  }
  .hero__particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
  }
  .hero__eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--space-md);
  }
  .hero__logo {
    width: min(84vw, 500px);
    height: auto;
    /* fond ivoire fondu autour du logo pour un rendu embossé sans bord net */
    -webkit-mask-image: radial-gradient(closest-side, #000 78%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 78%, transparent 100%);
    animation: nayra-float 8s var(--ease-soft) infinite;
    will-change: transform;
  }
  /* Halo doré qui respire derrière le logo */
  .hero::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 44%;
    width: min(72vw, 640px);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(201, 164, 139, 0.18) 0%, transparent 62%);
    z-index: -1;
    pointer-events: none;
    animation: nayra-glow 7s ease-in-out infinite;
  }
  .hero__baseline {
    max-width: 42ch;
    margin-top: var(--space-sm);
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.6;
    color: var(--stone);
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-lg);
  }
  .hero__secondary {
    color: var(--ink);
    letter-spacing: 0.08em;
  }

  /* Indicateur de scroll */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--mist);
  }
  .hero__scroll-line {
    width: 1px;
    height: 46px;
    background: linear-gradient(var(--gold), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: -50%;
    left: 0;
    width: 100%;
    height: 50%;
    background: var(--ink);
    animation: scrollDown 2.4s var(--ease-soft) infinite;
  }
  .hero__scroll-text {
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }

  @media (max-width: 480px) {
    .hero__scroll { display: none; }
    .hero__logo { width: 88vw; }
  }
</style>

<script>
  // Poussière d'or flottante — ambiance cinématographique douce (canvas léger).
  const canvas = document.querySelector<HTMLCanvasElement>('[data-particles]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0, dpr = 1, dots: any[] = [], raf = 0, running = false;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      w = canvas.width = Math.max(1, Math.round(r.width * dpr));
      h = canvas.height = Math.max(1, Math.round(r.height * dpr));
      const target = Math.round((r.width * r.height) / 22000);
      const n = Math.max(16, Math.min(44, target));
      dots = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: (Math.random() * 1.5 + 0.5) * dpr,
        vy: -(Math.random() * 0.22 + 0.04) * dpr,
        vx: (Math.random() - 0.5) * 0.14 * dpr,
        a: Math.random() * 0.45 + 0.18,
        tw: Math.random() * Math.PI * 2,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      ctx.shadowColor = 'rgba(201,164,139,0.9)';
      for (const p of dots) {
        p.y += p.vy; p.x += p.vx; p.tw += 0.02;
        if (p.y < -12) { p.y = h + 12; p.x = Math.random() * w; }
        if (p.x < -12) p.x = w + 12; else if (p.x > w + 12) p.x = -12;
        const a = p.a * (0.55 + 0.45 * Math.sin(p.tw));
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, 6.283);
        ctx.fillStyle = `rgba(201,164,139,${a})`;
        ctx.shadowBlur = 5 * dpr;
        ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    };

    const start = () => { if (!running) { running = true; draw(); } };
    const stop = () => { running = false; cancelAnimationFrame(raf); };

    resize();
    start();
    window.addEventListener('resize', resize, { passive: true });
    new IntersectionObserver(
      (e) => (e[0].isIntersecting ? start() : stop()),
      { threshold: 0 }
    ).observe(canvas);
  }
</script>
