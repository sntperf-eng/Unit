---
import { brand } from '../data/site';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="hero__bg" data-parallax data-parallax-speed="0.15" aria-hidden="true"></div>

  <div class="hero__inner container">
    <div class="hero__content">
      <p class="hero__eyebrow" data-reveal>Coloration des ongles au henné</p>

      <h1 class="hero__title" data-reveal style="--reveal-delay: 80ms">
        <span class="hero__wordmark">{brand.name}</span>
      </h1>

      <p class="hero__slogan" data-reveal style="--reveal-delay: 200ms">
        {brand.slogan}
      </p>

      <p class="hero__baseline lead" data-reveal style="--reveal-delay: 320ms">
        {brand.baseline}
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 440ms">
        <a href="#kit" class="btn">
          Découvrir le kit
          <Icon name="arrow" size={17} class="btn__arrow" />
        </a>
        <a href="#marque" class="hero__secondary link-underline">Notre histoire</a>
      </div>
    </div>

    <div class="hero__visual" data-reveal style="--reveal-delay: 200ms" aria-hidden="true">
      <div class="hero__arch" data-parallax data-parallax-speed="-0.08">
        <svg viewBox="0 0 300 420" class="hero__illustration" role="presentation">
          <defs>
            <linearGradient id="archGrad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#f4ddd6" />
              <stop offset="0.55" stop-color="#ecd0c8" />
              <stop offset="1" stop-color="#e6c7be" />
            </linearGradient>
            <linearGradient id="stemGrad" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#9aa892" />
              <stop offset="1" stop-color="#b6c0ac" />
            </linearGradient>
          </defs>

          <!-- Arche piédestal -->
          <path
            d="M40 420V150a110 110 0 0 1 220 0v270Z"
            fill="url(#archGrad)"
          />

          <!-- Colonne de lumière douce -->
          <ellipse cx="150" cy="248" rx="60" ry="146" fill="#f7e8e1" opacity="0.4" />

          <!-- Brin de henné (botanique) — tige centrale + feuilles montantes symétriques -->
          <g stroke="url(#stemGrad)" stroke-width="1.8" stroke-linecap="round" fill="none">
            <path d="M150 360V132" />
            <path d="M150 322 L122 306" />
            <path d="M150 322 L178 306" />
            <path d="M150 280 L122 264" />
            <path d="M150 280 L178 264" />
            <path d="M150 240 L124 225" />
            <path d="M150 240 L176 225" />
            <path d="M150 202 L126 188" />
            <path d="M150 202 L174 188" />
          </g>
          <g fill="#adb9a4">
            <ellipse cx="116" cy="300" rx="17" ry="7" transform="rotate(52 116 300)" />
            <ellipse cx="184" cy="300" rx="17" ry="7" transform="rotate(-52 184 300)" />
            <ellipse cx="117" cy="258" rx="15" ry="6.3" transform="rotate(52 117 258)" />
            <ellipse cx="183" cy="258" rx="15" ry="6.3" transform="rotate(-52 183 258)" />
            <ellipse cx="119" cy="219" rx="13" ry="5.5" transform="rotate(52 119 219)" />
            <ellipse cx="181" cy="219" rx="13" ry="5.5" transform="rotate(-52 181 219)" />
            <ellipse cx="122" cy="182" rx="11" ry="4.8" transform="rotate(52 122 182)" />
            <ellipse cx="178" cy="182" rx="11" ry="4.8" transform="rotate(-52 178 182)" />
          </g>
          <!-- Bourgeon doré -->
          <ellipse cx="150" cy="130" rx="6" ry="14" fill="#c9a48b" />

          <!-- Filet doré base -->
          <line x1="40" y1="378" x2="260" y2="378" stroke="#c9a48b" stroke-width="1" opacity="0.5" />
        </svg>
      </div>

      <span class="hero__float hero__float--1"></span>
      <span class="hero__float hero__float--2"></span>
    </div>
  </div>

  <a href="#marque" class="hero__scroll" aria-label="Défiler vers le bas">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-text">Découvrir</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(7rem, 12vh, 10rem) var(--space-xl);
    overflow: hidden;
  }
  .hero__bg {
    position: absolute;
    inset: -10% -10% 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 78% 12%, #f6e4dd 0%, transparent 55%),
      radial-gradient(90% 80% at 10% 90%, #f1e7d7 0%, transparent 50%),
      linear-gradient(180deg, var(--ivory) 0%, var(--cream) 100%);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: var(--space-lg);
    width: 100%;
  }
  .hero__eyebrow {
    font-size: var(--step--1);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--rose-gold);
    margin-bottom: var(--space-sm);
  }
  .hero__title {
    margin: 0;
  }
  .hero__wordmark {
    display: block;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(4.5rem, 16vw, 11rem);
    letter-spacing: 0.12em;
    line-height: 0.95;
    padding-left: 0.12em;
    background: linear-gradient(120deg, var(--ink) 30%, var(--rose-gold) 120%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__slogan {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 300;
    font-style: italic;
    color: var(--stone);
    margin-top: var(--space-xs);
  }
  .hero__baseline {
    max-width: 34ch;
    margin-top: var(--space-md);
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-top: var(--space-lg);
  }
  .hero__secondary {
    color: var(--ink);
    letter-spacing: 0.08em;
  }

  /* Visuel */
  .hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero__arch {
    position: relative;
    width: min(100%, 360px);
    filter: drop-shadow(0 30px 60px rgba(201, 164, 139, 0.28));
    animation: floaty 9s var(--ease-soft) infinite;
  }
  .hero__illustration {
    width: 100%;
    height: auto;
  }
  .hero__float {
    position: absolute;
    border-radius: 50%;
    border: 1px solid var(--rose-gold);
    opacity: 0.4;
  }
  .hero__float--1 {
    width: 90px;
    height: 90px;
    top: 6%;
    right: 2%;
    animation: floaty 11s var(--ease-soft) infinite reverse;
  }
  .hero__float--2 {
    width: 40px;
    height: 40px;
    bottom: 14%;
    left: 0;
    background: var(--powder);
    border: none;
    animation: floaty 7s var(--ease-soft) infinite;
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }

  /* Indicateur de scroll */
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--mist);
  }
  .hero__scroll-line {
    width: 1px;
    height: 46px;
    background: linear-gradient(var(--rose-gold), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    top: -50%;
    left: 0;
    width: 100%;
    height: 50%;
    background: var(--ink);
    animation: scrollDown 2.4s var(--ease-soft) infinite;
  }
  .hero__scroll-text {
    font-size: 0.68rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  @keyframes scrollDown {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(300%); }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: var(--space-md);
    }
    .hero__baseline {
      margin-inline: auto;
    }
    .hero__actions {
      justify-content: center;
    }
    .hero__visual {
      order: -1;
      margin-bottom: var(--space-sm);
    }
    .hero__arch {
      width: min(70%, 260px);
    }
    .hero__float--1 { width: 60px; height: 60px; }
  }
  @media (max-width: 480px) {
    .hero__scroll { display: none; }
  }
</style>
