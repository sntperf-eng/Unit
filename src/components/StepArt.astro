---
/**
 * StepArt — illustration du rituel, une par étape.
 * Dessins linéaires or/henné sur fond beige, dans l'esprit du logo.
 * (Illustrations sur mesure ; remplaçables par de vraies photos plus tard.)
 */
interface Props {
  n: 1 | 2 | 3 | 4;
}
const { n } = Astro.props;

const gold = '#b98f5c';
const henne = '#7c4a38';
const light = '#e7d4bc';
const sand = '#e6cdae';
const finger = '#f6ecdf';
const cid = `stepclip-${n}`;
---

<svg viewBox="0 0 160 160" class="step-art" role="img" aria-hidden="true">
  <defs>
    <clipPath id={cid}>
      <circle cx="80" cy="80" r="70" />
    </clipPath>
  </defs>

  <circle cx="80" cy="80" r="70" fill="#f3e8d9" />
  <g clip-path={`url(#${cid})`}>
    {n === 1 && (
      <g>
        {/* Lime posée en diagonale, derrière le doigt */}
        <line x1="32" y1="128" x2="118" y2="70" stroke={light} stroke-width="12" stroke-linecap="round" />
        <line x1="32" y1="128" x2="118" y2="70" stroke={gold} stroke-width="1.3" stroke-linecap="round" opacity="0.4" />
        {/* Doigt + ongle préparé */}
        <path d="M66 152 L66 88 C66 68 71 55 80 55 C89 55 94 68 94 88 L94 152Z" fill={finger} stroke={gold} stroke-width="2.4" stroke-linejoin="round" />
        <ellipse cx="80" cy="74" rx="10" ry="13" fill="#fff" stroke={gold} stroke-width="2" />
        <path d="M71 86 Q80 82 89 86" fill="none" stroke={gold} stroke-width="1.8" stroke-linecap="round" />
      </g>
    )}

    {n === 2 && (
      <g>
        {/* Doigt + ongle en cours d'application */}
        <path d="M60 152 L60 88 C60 68 65 55 74 55 C83 55 88 68 88 88 L88 152Z" fill={finger} stroke={gold} stroke-width="2.4" stroke-linejoin="round" />
        <ellipse cx="74" cy="74" rx="10" ry="13" fill="#fff" stroke={gold} stroke-width="2" />
        {/* Trace de henné sur l'ongle */}
        <path d="M65 78 Q74 74 83 78 Q82 88 74 89 Q66 88 65 78Z" fill={henne} />
        {/* Pinceau */}
        <line x1="132" y1="40" x2="94" y2="70" stroke={gold} stroke-width="3.2" stroke-linecap="round" />
        <line x1="94" y1="70" x2="86" y2="76" stroke={gold} stroke-width="6" stroke-linecap="round" />
        <path d="M86 76 L77 82 M89 73 L81 80 M83 79 L75 84" stroke={henne} stroke-width="1.6" stroke-linecap="round" />
        {/* Goutte */}
        <path d="M112 52 C112 56 108 58 108 61 A4 4 0 0 0 116 61 C116 58 112 56 112 52Z" fill={henne} opacity="0.85" />
      </g>
    )}

    {n === 3 && (
      <g fill="none" stroke={gold} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        {/* Sablier */}
        <line x1="52" y1="42" x2="108" y2="42" />
        <line x1="52" y1="118" x2="108" y2="118" />
        <path d="M57 42 C57 62 74 74 80 80 C86 74 103 62 103 42" />
        <path d="M57 118 C57 98 74 86 80 80 C86 86 103 98 103 118" />
        {/* Sable */}
        <path d="M63 48 C67 60 76 69 80 72 C84 69 93 60 97 48Z" fill={sand} stroke="none" />
        <path d="M68 112 Q80 100 92 112Z" fill={sand} stroke="none" />
        <line x1="80" y1="82" x2="80" y2="102" stroke={gold} stroke-width="1.6" stroke-dasharray="1 5" />
        {/* Petite brindille */}
        <path d="M118 128 C118 118 122 114 128 112" stroke-width="1.6" opacity="0.7" />
        <path d="M120 122 C116 121 114 118 114 114" stroke-width="1.6" opacity="0.7" />
      </g>
    )}

    {n === 4 && (
      <g>
        {/* Doigt + ongle coloré (résultat) */}
        <path d="M66 152 L66 88 C66 68 71 55 80 55 C89 55 94 68 94 88 L94 152Z" fill={finger} stroke={gold} stroke-width="2.4" stroke-linejoin="round" />
        <ellipse cx="80" cy="74" rx="10" ry="13" fill={henne} stroke={gold} stroke-width="2" />
        <path d="M74 68 Q78 65 82 67" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" opacity="0.6" />
        {/* Étincelles de révélation */}
        <path d="M112 50 C113 56 114 57 120 58 C114 59 113 60 112 66 C111 60 110 59 104 58 C110 57 111 56 112 50Z" fill={gold} />
        <circle cx="102" cy="40" r="2" fill={gold} />
        <circle cx="122" cy="74" r="1.6" fill={gold} />
      </g>
    )}
  </g>

  {/* Anneau fin */}
  <circle cx="80" cy="80" r="70" fill="none" stroke="#e4d0b5" stroke-width="1.5" />
</svg>

<style>
  .step-art {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
