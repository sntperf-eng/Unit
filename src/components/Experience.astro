---
import Icon from './Icon.astro';

const points = [
  { icon: 'leaf', label: 'Naturel' },
  { icon: 'sparkle', label: 'Soin & élégance' },
  { icon: 'hand', label: 'Facile à utiliser' },
  { icon: 'gift', label: 'Idéal à offrir' },
];
---

<section class="xp section">
  <div class="container xp__inner">
    <figure class="xp__media img-reveal" data-reveal>
      <img
        src="/kit-box.webp"
        width="1010"
        height="544"
        alt="Le kit NAYRA présenté dans son coffret : chaque élément disposé avec soin sur un lit de frisure kraft."
        loading="lazy"
        decoding="async"
        data-parallax
        data-parallax-speed="0.04"
      />
    </figure>

    <div class="xp__content">
      <p class="eyebrow" data-reveal>L'expérience NAYRA</p>
      <h2 class="section-title" data-reveal style="--reveal-delay: 60ms">
        Un écrin pensé dans le moindre détail.
      </h2>
      <p class="lead" data-reveal style="--reveal-delay: 120ms">
        Chaque détail est pensé pour offrir un moment de soin, un rituel de
        beauté naturel et une expérience premium — de l'ouverture du coffret
        jusqu'au dernier geste.
      </p>

      <ul class="xp__points" data-reveal style="--reveal-delay: 200ms">
        {points.map((p) => (
          <li class="xp__point">
            <span class="xp__point-icon"><Icon name={p.icon} size={22} /></span>
            <span class="xp__point-label">{p.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .xp {
    background: var(--ivory);
  }
  .xp__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-xl);
  }
  .xp__media {
    position: relative;
    aspect-ratio: 1010 / 544;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .xp__media img {
    position: absolute;
    inset: -12% 0;
    width: 100%;
    height: 124%;
    object-fit: cover;
    display: block;
    will-change: transform;
  }
  .xp__content .lead {
    margin-top: var(--space-sm);
  }
  .xp__points {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }
  .xp__point {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .xp__point-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    color: var(--rose-gold);
    border: 1px solid var(--line);
    background: var(--cream);
    transition: transform 0.5s var(--ease), color 0.5s var(--ease),
      background-color 0.5s var(--ease);
  }
  .xp__point:hover .xp__point-icon {
    transform: translateY(-3px);
    color: var(--ink);
    background: var(--warm-beige);
  }
  .xp__point-label {
    font-size: var(--step-0);
    letter-spacing: 0.02em;
  }

  @media (max-width: 860px) {
    .xp__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
    .xp__media {
      order: -1;
    }
  }
</style>
