---
/**
 * Logo NAYRA — signature typographique avec petite marque botanique.
 * Basé sur la police d'affichage pour une netteté parfaite à toute taille.
 */
interface Props {
  showMark?: boolean;
  class?: string;
}
const { showMark = true, class: className = '' } = Astro.props;
---

<span class={`logo ${className}`} aria-label="NAYRA">
  {showMark && (
    <svg class="logo__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path
        d="M16 3c-1.6 5.8-3.9 8.1-9 9 5.1.9 7.4 3.2 9 9 1.6-5.8 3.9-8.1 9-9-5.1-.9-7.4-3.2-9-9Z"
        stroke="currentColor"
        stroke-width="1"
        stroke-linejoin="round"
      />
    </svg>
  )}
  <span class="logo__word">NAYRA</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ink);
    line-height: 1;
  }
  .logo__mark {
    width: 0.85em;
    height: 0.85em;
    flex: none;
    color: var(--rose-gold);
    transition: transform 0.6s var(--ease);
  }
  .logo:hover .logo__mark {
    transform: rotate(90deg);
  }
  .logo__word {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5em;
    letter-spacing: 0.32em;
    /* compense l'espacement à droite pour un centrage optique */
    padding-left: 0.32em;
  }
</style>
