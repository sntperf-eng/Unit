---
import Icon from './Icon.astro';
import { brand, footerLinks } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__brand-row">
      <a href="#top" aria-label="NAYRA — retour en haut" class="footer__logo">
        <img
          src="/nayra-logo.webp"
          width="1120"
          height="1120"
          alt={`${brand.name} — ${brand.slogan}`}
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <div class="footer__top">
      <div class="footer__col footer__about">
        <p class="footer__tagline">
          Une marque de soins et de beauté, pensée pour vous. Naturelle,
          élégante, sans compromis.
        </p>
        <div class="footer__social">
          <a href={brand.social.instagram} class="footer__social-link" aria-label="Instagram" rel="noopener" target="_blank">
            <Icon name="instagram" size={20} />
          </a>
          <a href={brand.social.tiktok} class="footer__social-link" aria-label="TikTok" rel="noopener" target="_blank">
            <Icon name="tiktok" size={20} />
          </a>
        </div>
      </div>

      <nav class="footer__col" aria-label="Navigation pied de page">
        <h2 class="footer__heading">Explorer</h2>
        <ul>
          {footerLinks.navigation.map((l) => (
            <li><a href={l.href} class="footer__link">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Informations légales">
        <h2 class="footer__heading">Informations</h2>
        <ul>
          {footerLinks.legal.map((l) => (
            <li><a href={l.href} class="footer__link">{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="footer__col footer__contact">
        <h2 class="footer__heading">Contact</h2>
        <a href={`mailto:${brand.email}`} class="footer__link">{brand.email}</a>
        <p class="footer__contact-note">
          Une question ? Nous vous répondons avec soin.
        </p>
      </div>
    </div>

    <div class="footer__bottom">
      <p>© {year} {brand.name}. Tous droits réservés.</p>
      <p class="footer__made">La beauté sans compromis.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--cream) 0%, var(--warm-beige) 100%);
    color: var(--stone);
    padding-block: var(--space-xl) var(--space-lg);
  }
  .footer__brand-row {
    display: flex;
    justify-content: center;
    padding-bottom: var(--space-md);
  }
  .footer__logo img {
    width: 200px;
    height: auto;
    -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
    transition: opacity 0.4s var(--ease);
  }
  .footer__logo:hover img {
    opacity: 0.8;
  }
  .footer__top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid rgba(169, 129, 77, 0.18);
    border-bottom: 1px solid rgba(169, 129, 77, 0.18);
  }
  .footer__tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
    max-width: 34ch;
  }
  .footer__social {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--space-md);
  }
  .footer__social-link {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: var(--gold);
    border: 1px solid rgba(169, 129, 77, 0.3);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease),
      transform 0.4s var(--ease), border-color 0.4s var(--ease);
  }
  .footer__social-link:hover {
    background: var(--gold);
    color: #fff;
    transform: translateY(-3px);
    border-color: var(--gold);
  }
  .footer__heading {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: var(--space-sm);
  }
  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .footer__link {
    font-size: var(--step--1);
    color: var(--stone);
    transition: color 0.3s var(--ease);
  }
  .footer__link:hover {
    color: var(--ink);
  }
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    align-items: flex-start;
  }
  .footer__contact-note {
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--mist);
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: var(--space-md);
    font-size: 0.8rem;
    color: var(--mist);
  }

  @media (max-width: 780px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-md) var(--space-lg);
    }
    .footer__about {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .footer__top {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .footer__social { justify-content: center; }
    .footer__contact { align-items: center; }
    .footer__bottom {
      justify-content: center;
      text-align: center;
    }
  }
</style>
