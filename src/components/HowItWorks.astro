---
import Icon from './Icon.astro';
import { steps, poseLevels, secret } from '../data/site';

const cardSteps = steps.slice(0, 4);
const poseStep = steps[4];
const revealStep = steps[5];
const swatch = ['#d8b9a8', '#b07a5f', '#7c4a38'];
---

<section class="ritual section" id="rituel">
  <div class="container">
    <div class="ritual__head" data-reveal>
      <p class="eyebrow">Le rituel</p>
      <h2 class="section-title">Comment utiliser NAYRA</h2>
      <p class="lead">
        Six gestes simples, guidés pas à pas. Laissez-vous porter par le rituel.
      </p>
    </div>

    <!-- Étapes 1 à 4 en cartes -->
    <div class="ucards">
      {cardSteps.map((step, i) => (
        <article class="ucard" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <span class="ucard__photo">
            <img src={step.photo} width="564" height="316" alt={step.title} loading="lazy" decoding="async" />
          </span>
          <div class="ucard__body">
            <span class="ucard__label">
              <Icon name={step.icon} size={14} />
              Étape {step.n} · {step.phase}
            </span>
            <h3 class="ucard__title">{step.title}</h3>
            <p class="ucard__text">{step.text}</p>
            {step.tip && (
              <p class="ucard__tip"><Icon name="sparkle" size={13} /> {step.tip}</p>
            )}
          </div>
        </article>
      ))}
    </div>

    <!-- Étape 5 — mise en valeur : temps de pose -->
    <div class="pose" data-reveal>
      <div class="pose__intro">
        <span class="pose__label">
          <Icon name="clock" size={16} /> Étape {poseStep.n} · {poseStep.phase}
        </span>
        <h3 class="pose__title">{poseStep.title}</h3>
        <p class="pose__text">
          {poseStep.text} Vous décidez de l'intensité de votre couleur.
        </p>
      </div>

      <div class="pose__scale">
        {poseLevels.map((lvl, i) => (
          <div class="pose__tier">
            <span class="pose__icon"><Icon name={lvl.icon} size={22} /></span>
            <span class="pose__swatch" style={`background:${swatch[i]}`}></span>
            <span class="pose__time">{lvl.time}</span>
            <span class="pose__intensity">{lvl.label}</span>
          </div>
        ))}
        <span class="pose__bar" aria-hidden="true"></span>
      </div>
    </div>

    <!-- Étape 6 — révélation -->
    <article class="reveal-step" data-reveal>
      <span class="reveal-step__photo">
        <img src={revealStep.photo} width="580" height="356" alt="Avant / après : la couleur révélée sur l'ongle" loading="lazy" decoding="async" />
      </span>
      <div class="reveal-step__body">
        <span class="ucard__label">
          <Icon name={revealStep.icon} size={15} />
          Étape {revealStep.n} · {revealStep.phase}
        </span>
        <h3 class="reveal-step__title">{revealStep.title}</h3>
        <p class="reveal-step__text">{revealStep.text}</p>
      </div>
    </article>

    <!-- Encart secret -->
    <div class="secret" data-reveal>
      <span class="secret__icon"><Icon name="sparkle" size={26} /></span>
      <div class="secret__body">
        <h3 class="secret__title">{secret.title}</h3>
        <p class="secret__text">{secret.text}</p>
      </div>
    </div>

    <!-- Guide inclus dans le coffret -->
    <article class="guide" data-reveal>
      <div class="guide__media">
        <img src="/guide.webp" width="900" height="1350" alt="Le guide illustré du rituel NAYRA, inclus dans chaque coffret" loading="lazy" decoding="async" />
      </div>
      <div class="guide__body">
        <span class="ucard__label"><Icon name="book" size={14} /> Inclus dans le coffret</span>
        <h3 class="guide__title">Un guide illustré, glissé dans chaque boîte.</h3>
        <p class="guide__text">
          Chaque rituel est détaillé pas à pas sur une belle carte imprimée —
          avec un QR code vers le tutoriel vidéo et tous nos conseils
          d'application. Pour ne jamais hésiter, même la première fois.
        </p>
      </div>
    </article>
  </div>
</section>

<style>
  .ritual {
    background: linear-gradient(180deg, var(--ivory) 0%, var(--cream) 100%);
  }
  .ritual__head {
    text-align: center;
    max-width: 44ch;
    margin: 0 auto var(--space-xl);
  }
  .ritual__head .lead {
    margin-top: var(--space-sm);
  }

  /* Cartes d'étapes */
  .ucards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(0.75rem, 1.4vw, 1.15rem);
  }
  .ucard {
    display: flex;
    flex-direction: column;
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  .ucard:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-soft);
    border-color: var(--sand);
  }
  .ucard__photo {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--cream);
  }
  .ucard__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .ucard:hover .ucard__photo img {
    transform: scale(1.06);
  }
  .ucard__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: var(--space-md) var(--space-sm);
  }
  .ucard__tip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.95rem;
    color: var(--gold);
  }
  .ucard__tip svg {
    flex: none;
  }
  .ucard__label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rose-gold);
  }
  .ucard__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.15;
  }
  .ucard__text {
    font-size: var(--step--1);
    line-height: 1.55;
    color: var(--stone);
  }

  /* Étape 5 — bandeau temps de pose */
  .pose {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: var(--space-xl);
    margin-top: var(--space-md);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border-radius: var(--radius-lg);
    color: var(--cream);
    background:
      radial-gradient(120% 140% at 15% 0%, #4a352b 0%, transparent 55%),
      linear-gradient(135deg, #3a2a22 0%, #2c2723 100%);
    box-shadow: var(--shadow-lift);
  }
  .pose__label {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-light);
  }
  .pose__title {
    font-size: var(--step-3);
    font-weight: 300;
    color: var(--ivory);
    margin: var(--space-xs) 0 var(--space-sm);
  }
  .pose__text {
    font-size: var(--step-0);
    line-height: 1.65;
    color: rgba(244, 236, 225, 0.75);
    max-width: 40ch;
  }
  .pose__scale {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }
  .pose__bar {
    position: absolute;
    top: 26px;
    left: 8%;
    right: 8%;
    height: 2px;
    background: linear-gradient(90deg, #d8b9a8, #b07a5f, #7c4a38);
    border-radius: 2px;
    z-index: 0;
  }
  .pose__tier {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
  }
  .pose__icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    color: var(--gold-light);
    background: #2c2723;
    border: 1px solid rgba(201, 164, 139, 0.4);
  }
  .pose__swatch {
    width: 34px;
    height: 8px;
    border-radius: 4px;
    margin-top: 0.15rem;
  }
  .pose__time {
    font-family: var(--font-display);
    font-size: var(--step-1);
    color: var(--ivory);
    line-height: 1.1;
  }
  .pose__intensity {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 236, 225, 0.6);
  }

  /* Étape 6 — révélation */
  .reveal-step {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-md);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }
  .reveal-step__photo {
    flex: none;
    align-self: stretch;
    display: flex;
    width: clamp(200px, 30vw, 320px);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .reveal-step__photo img {
    width: 100%;
    height: 100%;
    min-height: 170px;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .reveal-step:hover .reveal-step__photo img {
    transform: scale(1.05);
  }
  .reveal-step__title {
    font-size: var(--step-2);
    font-weight: 400;
    margin: var(--space-xs) 0 0.4rem;
  }
  .reveal-step__text {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--stone);
    max-width: 60ch;
  }

  /* Encart secret */
  .secret {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--sand);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(90% 120% at 100% 0%, #f4e3d3 0%, transparent 55%),
      linear-gradient(180deg, #fbf5ec 0%, var(--cream) 100%);
  }
  .secret__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    color: var(--gold);
    background: var(--ivory);
    border: 1px solid var(--sand);
  }
  .secret__title {
    font-size: var(--step-2);
    font-weight: 400;
    margin-bottom: 0.35rem;
  }
  .secret__text {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--stone);
    max-width: 62ch;
  }

  /* Guide inclus */
  .guide {
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    margin-top: var(--space-md);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--ivory);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .guide__media {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }
  .guide__media img {
    width: 100%;
    height: auto;
    display: block;
  }
  .guide__title {
    font-size: var(--step-2);
    font-weight: 400;
    margin: 0.4rem 0 0.6rem;
  }
  .guide__text {
    font-size: var(--step-0);
    line-height: 1.65;
    color: var(--stone);
    max-width: 52ch;
  }

  @media (max-width: 900px) {
    .ucards {
      grid-template-columns: repeat(2, 1fr);
    }
    .pose {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
  @media (max-width: 620px) {
    .reveal-step {
      flex-direction: column;
      text-align: center;
    }
    .reveal-step__photo {
      width: 100%;
    }
    .reveal-step__text {
      margin-inline: auto;
    }
    .secret {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .secret__text {
      margin-inline: auto;
    }
    .guide {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .guide__media {
      max-width: 260px;
      margin-inline: auto;
    }
    .guide__text {
      margin-inline: auto;
    }
  }
  @media (max-width: 380px) {
    .ucards {
      grid-template-columns: 1fr;
    }
  }
</style>
